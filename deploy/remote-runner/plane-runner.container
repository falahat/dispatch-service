[Unit]
Description=Authenticated application-plane runner
# The runner waits at its boot gate until compute is ready, so it only wants
# compute: a compute that fails to start at boot restarts on its own, where a
# requirement would leave this runner failed for good. A compute restart leaves
# this runner running: it takes no lease while compute is not ready, and a
# compute that exits after each response (INVOKE.md) must not stop its runner
# mid-upload.
Wants=@NAME@-compute.service
After=@NAME@-compute.service

[Container]
Image=@RUNNER_IMAGE@
ContainerName=@NAME@-runner
User=1000
Group=1000
UserNS=keep-id:uid=1000,gid=1000
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
Tmpfs=/tmp:rw,nosuid,nodev
Pull=never
PodmanArgs=--memory=1g --memory-swap=1g --cpus=1 --pids-limit=512
Network=@NAME@-edge.network
Network=@NAME@-invoke.network
Volume=@NAME@-work.volume:/work:U
Volume=%h/.config/plane-runners/@NAME@/cred:/run/plane-cred:ro
Environment=DISPATCHER_ADDR=@PLANE_ADDR@:7443
Environment=CAS_URL=http://@PLANE_ADDR@:8443
Environment=INVOKE_ADDR=@NAME@-compute:8080
Environment=WORK_ROOT=/work
Environment=LANES=@LANES@
Environment=CREDENTIAL=/run/plane-cred/runner.json
Environment=RUNNER_NODE=@RUNNER_NODE@

[Service]
TimeoutStartSec=0
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
