[Unit]
Description=Application compute

[Container]
Image=@COMPUTE_IMAGE@
ContainerName=@NAME@-compute
NetworkAlias=@NAME@-compute
User=1000
Group=1000
UserNS=keep-id:uid=1000,gid=1000
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
Tmpfs=/tmp:rw,nosuid,nodev
Tmpfs=/run:rw,nosuid,nodev,noexec,mode=0755
Pull=never
PodmanArgs=--memory=@MEMORY@ --memory-swap=@MEMORY@ --cpus=@CPUS@ --pids-limit=8192
Network=@NAME@-invoke.network
Volume=@NAME@-work.volume:/work:U
Environment=INVOKE_ADDR=0.0.0.0:8080
@COMPUTE_OPTIONS@

[Service]
TimeoutStartSec=0
