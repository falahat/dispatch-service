{
  "name": "@dispatch/client-web",
  "version": "0.1.0",
  "description": "Browser signer for the dispatch plane's PEP: libsodium Ed25519 proof-of-possession over the plane's canonical HTTP request, plus the BLAKE2b pairing MAC. Shared by every web peer (the easy-podcast PWA, the antibody frontend).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "jose": "^6.1.0",
    "libsodium-wrappers-sumo": "^0.7.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
