[Unit]
Description=Credential-free application compute

[Container]
Image=@COMPUTE_IMAGE@
ContainerName=plane-compute
NetworkAlias=plane-compute
User=1000
Group=1000
UserNS=keep-id:uid=1000,gid=1000
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
Tmpfs=/tmp:rw,nosuid,nodev
Pull=never
Network=plane-invoke.network
Volume=plane-work.volume:/work
Environment=INVOKE_ADDR=0.0.0.0:8080
@COMPUTE_OPTIONS@

[Service]
TimeoutStartSec=0
